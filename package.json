{
  "name": "semanticql",
  "version": "1.0.0",
  "description": "Simplified semantic SQL shell for PostgreSQL",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "semanticql": "./dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dhruv2x/semanticQL.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli/index.ts",
    "cli": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "postgres",
    "sql",
    "semantic",
    "cli",
    "database",
    "query"
  ],
  "dependencies": {
    "dotenv": "^17.4.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
