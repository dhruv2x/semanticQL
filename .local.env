# SemanticQL Local Development Environment Variables
# Copy this file to '.env' and adjust the values to connect to your local test database.

# The host of your PostgreSQL database. 
# (Leave blank or set to /var/run/postgresql to use local Unix sockets like native psql)
DB_HOST=127.0.0.1

# The port your database is running on (PostgreSQL default is 5432)
DB_PORT=5432

# The user to connect as. If omitted, falls back to your OS username.
DB_USER=postgres

# The password for the user. If you are using local peer authentication, leave this blank.
DB_PASSWORD=secretpassword
